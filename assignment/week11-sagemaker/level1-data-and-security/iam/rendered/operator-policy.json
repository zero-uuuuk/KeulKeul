{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::keulkeul-week11-{ACCOUNT_ID}-본인영문이름"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::keulkeul-week11-{ACCOUNT_ID}-본인영문이름/week11/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:Search"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreateTrainingJob",
        "sagemaker:DescribeTrainingJob",
        "sagemaker:StopTrainingJob",
        "sagemaker:AddTags"
      ],
      "Resource": [
        "arn:aws:sagemaker:ap-northeast-2:{ACCOUNT_ID}:training-job/keulkeul-w11-*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetRole"
      ],
      "Resource": "arn:aws:iam::{ACCOUNT_ID}:role/keulkeul-week11-sagemaker-role"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::{ACCOUNT_ID}:role/keulkeul-week11-sagemaker-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "sagemaker.amazonaws.com"
        }
      }
    }
  ]
}